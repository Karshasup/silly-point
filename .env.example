ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
FUSION_MODEL=claude-opus-4-6

# Whisper model size: tiny | base | small | medium | large
# "tiny" is fastest; "base" or "small" give better accuracy on umpire speech
WHISPER_MODEL=tiny

# Path to YOLO weights. Defaults to generic yolov8n.pt (COCO).
# Recommended: download the Roboflow cricket-ball-tracking-dataset model
# (universe.roboflow.com/cricket-ball-tracking-dataset/cricket-dataset-z2wkt)
# and point this at the downloaded best.pt.
YOLO_MODEL=yolov8n.pt

# Class indices — must match whatever model YOLO_MODEL points at.
# Roboflow cricket-ball-tracking-dataset: ball=0, stump=1 (defaults)
# COCO yolov8n.pt: ball=32, no stump class (set STUMP_CLASS to any unused int)
BALL_CLASS=0
STUMP_CLASS=1

# Vision tuning
SAMPLE_FPS=10.0       # frames per second to sample (lower = faster)
DELIVERY_GAP=2.0      # seconds without ball detection = new delivery
SIGNAL_WINDOW=3.0     # seconds after last ball detection to capture umpire signal
